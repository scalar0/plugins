set shell := ["bash", "-euo", "pipefail", "-c"]
set no-cd

script := justfile_directory() / "clippy-index.sh"

# List the public Cargo Clippy Index workflows.
default:
    @just -f "{{ justfile() }}" --list

# Scan a workspace and publish one immutable content-addressed run.
scan root="." config="" mode="strict":
    @bash "{{ script }}" scan "{{ root }}" "{{ config }}" "{{ mode }}"

# Render a stored run as Markdown without changing it.
report root="." run="current" view="residuals":
    @bash "{{ script }}" report "{{ root }}" "{{ run }}" "{{ view }}"

# Verify preconditions and atomically apply a run's aggregate patch.
apply root="." run="current":
    @bash "{{ script }}" apply "{{ root }}" "{{ run }}"

# Recompute and byte-compare the reproducibility-controlled artifacts.
verify root="." run="current":
    @bash "{{ script }}" verify "{{ root }}" "{{ run }}"

# Run syntax, fixture, golden, and integration tests.
test:
    @bash "{{ script }}" test
